{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tests.schema.json",
  "title": "Campus assessment tracker record",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "testId",
      "company",
      "jobTitle",
      "assessmentScope",
      "testType",
      "status",
      "sourceMaterials",
      "assessmentSummary",
      "analysisStatus",
      "createdAt",
      "updatedAt"
    ],
    "properties": {
      "testId": { "type": "string", "minLength": 1 },
      "company": { "type": "string", "minLength": 1 },
      "jobTitle": { "type": "string", "minLength": 1 },
      "jobId": { "type": "string" },
      "assessmentScope": { "enum": ["海测", "非海测"] },
      "testType": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "笔试｜行测 + 图推 + 性格测试",
            "笔试｜性格测试",
            "AI 笔试",
            "AI 面试",
            "英语面试",
            "其他"
          ]
        }
      },
      "customTestType": { "type": "string" },
      "status": { "enum": ["待完成", "已完成", "已过期"] },
      "dueAt": { "type": "string", "pattern": "^(|(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01]))$" },
      "completedAt": { "type": "string", "pattern": "^(|(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01]))$" },
      "testPlatform": { "type": "string" },
      "duration": { "type": "string" },
      "repeatEntry": { "enum": ["未知", "可重复进入", "不可重复进入"] },
      "testUrl": { "type": "string" },
      "sourceMaterials": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["materialId", "materialType", "title", "sourceUrl", "storageRef", "rawContent", "capturedAt", "contentHash"],
          "properties": {
            "materialId": { "type": "string", "minLength": 1 },
            "materialType": { "enum": ["excel", "image", "text", "web", "pdf", "word", "other"] },
            "title": { "type": "string", "minLength": 1 },
            "sourceUrl": { "type": "string" },
            "storageRef": { "type": "string" },
            "rawContent": { "type": "string" },
            "capturedAt": { "type": "string", "format": "date-time" },
            "contentHash": { "type": "string" }
          },
          "anyOf": [
            { "properties": { "sourceUrl": { "minLength": 1 } } },
            { "properties": { "storageRef": { "minLength": 1 } } },
            { "properties": { "rawContent": { "minLength": 1 } } }
          ],
          "additionalProperties": false
        }
      },
      "assessmentSummary": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "required": [
              "testComposition",
              "keyQuestionTypes",
              "timingAndPacing",
              "competenciesAssessed",
              "recurringSignals",
              "preparationAdvice",
              "conflicts",
              "conciseBullets",
              "sourceMaterialIds",
              "analyzedAt"
            ],
            "properties": {
              "testComposition": { "$ref": "#/$defs/stringList" },
              "keyQuestionTypes": { "$ref": "#/$defs/stringList" },
              "timingAndPacing": { "$ref": "#/$defs/stringList" },
              "competenciesAssessed": { "$ref": "#/$defs/stringList" },
              "recurringSignals": { "$ref": "#/$defs/stringList" },
              "preparationAdvice": {
                "type": "array",
                "minItems": 3,
                "maxItems": 5,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "conflicts": { "$ref": "#/$defs/stringList" },
              "conciseBullets": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "sourceMaterialIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "analyzedAt": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          }
        ]
      },
      "analysisStatus": { "enum": ["NEEDS_SOURCE", "NOT_ANALYZED", "CURRENT", "STALE"] },
      "notes": { "type": "string" },
      "createdAt": { "type": "string", "format": "date-time" },
      "updatedAt": { "type": "string", "format": "date-time" },
      "sourceOfTruth": { "enum": ["repo", "user", "daily-run", "local-draft"] }
    },
    "additionalProperties": false
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
